                    "type": "layout",
                    "h_alignment": "center",
                    "v_alignment": "center",
                    "key": "memories_row"
                  }
                }
              ]
            },
            {
              "type": "array",
              "orientation": "vertical",
              "dock": "left",
              "content": [
                {
                  "type": "array",
                  "orientation": "horizontal",
                  "content": [
                    {
                      "type": "group",
                      "header": "Item Settings",
                      "dock": "left",
                      "margin": "0,0,3,0",
