{
  //sets the trackers layout
  //more info: https://github.com/black-sliver/PopTracker/blob/master/doc/PACKS.md#layouts
  "tracker_horizontal": {
    "type": "container",
    "background": "#000000",
    "content": {
      "type": "dock",
      "dropshadow": true,
      "content": [
        {
          "type": "dock",
          "dock": "bottom",
          "content": [
            {
              "type": "array",
              "orientation": "vertical",
              "dock": "left",
              "content": [
                {
                  "type": "group",
                  "header": "Items",
                  "dock": "left",
                  "margin": "0,0,3,0",
                  "content": {
                    "type": "layout",
                    "h_alignment": "center",
                    "v_alignment": "center",
                    "key": "princess_row_1"
                  }
                },
                {
                  "type": "array",
                  "dock": "left",
                  "margin": "0,0,3,0",
                  "content": {
                    "type": "layout",
                    "h_alignment": "center",
                    "v_alignment": "center",
                    "key": "voice"
                  }
                },
                {
                  "type": "array",
                  "dock": "left",
                  "margin": "0,0,3,0",
                  "content": {
                    "type": "layout",
                    "h_alignment": "center",
                    "v_alignment": "center",
                    "key": "blade_row_1"
                  }
                },
                {
