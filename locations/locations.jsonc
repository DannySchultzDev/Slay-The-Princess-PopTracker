[
	{
		"name": "Princess Combo",
		"children": [
			{
				"name": "The Princess",
				"sections": [
					{
						"name": "You're on a path in the woods...",
						"ref": "Princess Gallery 1/You're on a path in the woods.../Gallery 1"
					},
					{
						"name": "And at the end of that path is a cabin.",
						"ref": "Princess Gallery 2/And at the end of that path is a cabin./Gallery 2"
					},
					{
						"name": "And in the basement of that cabin...",
						"ref": "Princess Gallery 3/And in the basement of that cabin.../Gallery 3"
					},
					{
						"name": "Is a Princess.",
						"ref": "Princess Gallery 4/Is a Princess./Gallery 4"
					},
					{
						"name": "Find the Tower.",
						"ref": "Princess Gallery 5/Find the Tower./Gallery 5"
					},
					{
						"name": "Find the Damsel.",
						"ref": "Princess Gallery 6/Find the Damsel./Gallery 6"
					},
					{
						"name": "Find the Nightmare.",
						"ref": "Princess Gallery 7/Find the Nightmare./Gallery 7"
					},
					{
						"name": "Find the Prisoner.",
						"ref": "Princess Gallery 8/Find the Prisoner./Gallery 8"
					},
					{
						"name": "Find the Spectre.",
						"ref": "Princess Gallery 9/Find the Spectre./Gallery 9"
					},
					{
						"name": "Find the Razor.",
						"ref": "Princess Gallery 10/Find the Razor./Gallery 10"
					},
					{
						"name": "Find the Witch.",
						"ref": "Princess Gallery 11/Find the Witch./Gallery 11"
					},
					{
						"name": "Find the Beast.",
						"ref": "Princess Gallery 12/Find the Beast./Gallery 12"
					},
					{
						"name": "Find the Adversary.",
						"ref": "Princess Gallery 13/Find the Adversary./Gallery 13"
					},
					{
						"name": "Find the Stranger.",
						"ref": "Princess Gallery 14/Find the Stranger./Gallery 14"
					},
					{
						"name": "I thought you said she wasn't armed!",
						"ref": "Princess Gallery 15/I thought you said she wasn't armed!/Gallery 15"
					},
					{
						"name": "Get her to break her own chains.",
						"ref": "Princess Gallery 16/Get her to break her own chains./Gallery 16"
					},
					{
						"name": "Always leave a means of easy egress.",
						"ref": "Princess Gallery 17/Always leave a means of easy egress./Gallery 17"
					},
					{
						"name": "Everything would be so easy if you would just do exactly as I say as quickly as you can.",
						"ref": "Princess Gallery 18/Everything would be so easy if you would just do exactly as I say as quickly as you can./Gallery 18"
					}
				],
				"map_locations": [
