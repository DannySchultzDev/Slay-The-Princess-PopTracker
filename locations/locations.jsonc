	{
		"name": "Clarity Combo",
		"children": [
			{
				"name": "The Moment of Clarity",
				"sections": [
					{
						"name": "The Moment of Clarity",
						"ref": "Spaces Chapter III/Chapter III/The Moment of Clarity"
					},
					{
						"name": "Mirror",
						"ref": "Clarity Gallery 2/And this isn't the same cabin./Mirror"
					},
					{
						"name": "A wise heart",
						"ref": "Clarity Gallery 13/A wise heart./A wise heart"
					},
					{
						"name": "These aren't the same woods.",
						"ref": "Clarity Gallery 1/These aren't the same woods./Gallery 1"
					},
					{
						"name": "And this isn't the same cabin.",
						"ref": "Clarity Gallery 2/And this isn't the same cabin./Gallery 2"
					},
					{
						"name": "You're just an object.",
						"ref": "Clarity Gallery 3/You're just an object./Gallery 3"
					},
					{
						"name": "A tool.",
						"ref": "Clarity Gallery 4/A tool./Gallery 4"
					},
					{
						"name": "You once were something else, a long time ago.",
						"ref": "Clarity Gallery 5/You once were something else, a long time ago./Gallery 5"
					},
					{
						"name": "But was that something you?",
						"ref": "Clarity Gallery 6/But was that something you?/Gallery 6"
					},
					{
						"name": "Or is it just a dull and jaded memory?",
						"ref": "Clarity Gallery 7/Or is it just a dull and jaded memory?/Gallery 7"
					},
					{
						"name": "There is no other ending here.",
						"ref": "Clarity Gallery 8/There is no other ending here./Gallery 8"
					},
					{
						"name": "Just take her hand and set her free.",
						"ref": "Clarity Gallery 9/Just take her hand and set her free./Gallery 9"
					},
					{
						"name": "For all her past cruelties, the moment feels gentle, tender even.",
						"ref": "Clarity Gallery 10/For all her past cruelties, the moment feels gentle, tender even./Gallery 10"
					},
					{
						"name": "And that's the end! I wonder what we're going to do next.",
						"ref": "Clarity Gallery 11/And that's the end! I wonder what we're going to do next./Gallery 11"
					},
					{
						"name": "You've been here before.",
						"ref": "Clarity Gallery 12/You've been here before./Gallery 12"
					},
					{
						"name": "A wise heart.",
						"ref": "Clarity Gallery 13/A wise heart./Gallery 13"
					},
					{
						"name": "See through her eyes at the end of everything.",
						"ref": "Clarity Gallery 14/See through her eyes at the end of everything./Gallery 14"
					}
				],
				"map_locations": [
					{
						"map": "nightmare",
						"x": 1850,
						"y": 860
					},
					{
						"map": "overview",
						"x": 1099,
						"y": 1038
					}
				]
			}
		]
