					},
					{
						"name": "Mirror",
						"ref": "Needle Gallery 3/I thought this was supposed to be a cabin./Mirror"
					},
					{
						"name": "A burning heart",
						"ref": "Needle Gallery 19/A burning heart./A burning heart"
					},
					{
						"name": "These aren't the same woods.",
						"ref": "Needle Gallery 1/These aren't the same woods./Gallery 1"
					},
