	{
		"name": "Cage Combo",
		"children": [
			{
				"name": "The Cage",
				"sections": [
					{
						"name": "The Cage",
						"ref": "Spaces Chapter III/Chapter III/The Cage"
					},
					{
						"name": "Mirror",
						"ref": "Cage Gallery 3/If the Princess lives here, slaying her would probably be doing her a favor./Mirror"
					},
					{
						"name": "An open or watchful heart",
						"ref": "Cage Gallery 19/An open or watchful heart./An open or watchful heart"
					},
					{
						"name": "These aren't the same woods. We must be getting closer.",
						"ref": "Cage Gallery 1/These aren't the same woods. We must be getting closer./Gallery 1"
					},
					{
						"name": "Because getting to the cabin was too easy last time.",
						"ref": "Cage Gallery 2/Because getting to the cabin was too easy last time./Gallery 2"
					},
					{
						"name": "If the Princess lives here, slaying her would probably be doing her a favor.",
						"ref": "Cage Gallery 3/If the Princess lives here, slaying her would probably be doing her a favor./Gallery 3"
					},
					{
						"name": "You make out a figure standing in the gloom, obscured in shadow.",
						"ref": "Cage Gallery 4/You make out a figure standing in the gloom, obscured in shadow./Gallery 4"
					},
					{
						"name": "You give me your implement. See? You already did that part.",
						"ref": "Cage Gallery 5/You give me your implement. See? You already did that part./Gallery 5"
					},
					{
						"name": "This is all getting so predictable, isn't it? Pop.",
						"ref": "Cage Gallery 6/This is all getting so predictable, isn't it? Pop./Gallery 6"
					},
					{
						"name": "You only ever thought you were in control. Isn't it so much nicer to let go?",
						"ref": "Cage Gallery 7/You only ever thought you were in control. Isn't it so much nicer to let go?/Gallery 7"
					},
					{
						"name": "You only ever thought you were in control. Isn't it so much nicer to let go?",
						"ref": "Cage Gallery 8/You only ever thought you were in control. Isn't it so much nicer to let go?/Gallery 8"
					},
					{
						"name": "You only ever thought you were in control. Isn't it so much nicer to let go?",
						"ref": "Cage Gallery 9/You only ever thought you were in control. Isn't it so much nicer to let go?/Gallery 9"
					},
					{
						"name": "Both hers and yours collapse, their dance complete.",
						"ref": "Cage Gallery 10/Both hers and yours collapse, their dance complete./Gallery 10"
					},
					{
						"name": "A peace offering.",
						"ref": "Cage Gallery 11/A peace offering./Gallery 11"
					},
					{
						"name": "The things we leave behind.",
						"ref": "Cage Gallery 12/The things we leave behind./Gallery 12"
					},
					{
						"name": "At the edge of freedom.",
						"ref": "Cage Gallery 13/At the edge of freedom./Gallery 13"
					},
					{
						"name": "It's a little cold out here, isn't it?",
						"ref": "Cage Gallery 14/It's a little cold out here, isn't it?/Gallery 14"
					},
					{
						"name": "All of that, just to take it all away. You're cold.",
						"ref": "Cage Gallery 15/All of that, just to take it all away. You're cold./Gallery 15"
					},
					{
						"name": "I cut myself free.",
						"ref": "Cage Gallery 16/I cut myself free./Gallery 16"
					},
					{
						"name": "I cut myself free.",
						"ref": "Cage Gallery 17/I cut myself free./Gallery 17"
					},
					{
						"name": "You've been here before.",
						"ref": "Cage Gallery 18/You've been here before./Gallery 18"
					},
					{
						"name": "An open or watchful heart.",
						"ref": "Cage Gallery 19/An open or watchful heart./Gallery 19"
					},
					{
						"name": "See through her eyes at the end of everything.",
						"ref": "Cage Gallery 20/See through her eyes at the end of everything./Gallery 20"
					}
				],
