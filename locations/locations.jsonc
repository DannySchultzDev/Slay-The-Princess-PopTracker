	{
		"name": "Dragon Combo",
		"children": [
			{
				"name": "The Princess and the Dragon",
				"sections": [
					{
						"name": "The Princess and the Dragon",
						"ref": "Spaces Chapter III/Chapter III/The Princess and the Dragon"
					},
					{
						"name": "An empathetic heart",
						"ref": "Dragon Gallery 18/An empathetic heart./An empathetic heart"
					},
					{
						"name": "An empathetic heart, held in stencil",
						"ref": "Dragon Gallery 19/An empathetic heart, held in stencil./An empathetic heart, held in stencil"
					},
					{
						"name": "An empathetic heart, possibly held in stencil",
						"ref": "Dragon Gallery 18/An empathetic heart./An empathetic heart, possibly held in stencil"
					},
					{
						"name": "So that's you.",
						"ref": "Dragon Gallery 1/So that's you./Gallery 1"
					},
					{
						"name": "There has to be something for you to do other than wait, but that won't stop you from waiting as long as you can.",
						"ref": "Dragon Gallery 2/There has to be something for you to do other than wait, but that won't stop you from waiting as long as you can./Gallery 2"
					},
					{
						"name": "Observe your new form.",
						"ref": "Dragon Gallery 3/Observe your new form./Gallery 3"
					},
					{
						"name": "A figure emerges, shrouded in a feathered darkness, the world trailing behind it.",
						"ref": "Dragon Gallery 4/A figure emerges, shrouded in a feathered darkness, the world trailing behind it./Gallery 4"
					},
					{
						"name": "Reveal your identity to some old friends. A brash enough host might do this for you.",
						"ref": "Dragon Gallery 5/Reveal your identity to some old friends. A brash enough host might do this for you./Gallery 5"
					},
					{
						"name": "Keep your identity hidden from some old friends. Might require a more receptive host.",
						"ref": "Dragon Gallery 6/Keep your identity hidden from some old friends. Might require a more receptive host./Gallery 6"
					},
					{
						"name": "Abandon a gentle companion to her fate.",
						"ref": "Dragon Gallery 7/Abandon a gentle companion to her fate./Gallery 7"
					},
					{
						"name": "What once was one, then was two...",
						"ref": "Dragon Gallery 8/What once was one, then was two.../Gallery 8"
					},
					{
						"name": "And then was one again...",
						"ref": "Dragon Gallery 9/And then was one again.../Gallery 9"
					},
					{
						"name": "Welcome back! I'm so disappointed in you.",
						"ref": "Dragon Gallery 10/Welcome back! I'm so disappointed in you./Gallery 10"
					},
					{
						"name": "Fail to disarm a harsh companion.",
						"ref": "Dragon Gallery 11/Fail to disarm a harsh companion./Gallery 11"
					},
					{
						"name": "Welcome back! Life is all about taking the easy wins, isn't it?",
						"ref": "Dragon Gallery 12/Welcome back! Life is all about taking the easy wins, isn't it?/Gallery 12"
					},
					{
						"name": "Attempt to free a gentle companion on your own.",
						"ref": "Dragon Gallery 13/Attempt to free a gentle companion on your own./Gallery 13"
					},
