	{
		"name": "Apotheosis Combo",
		"children": [
			{
				"name": "The Apotheosis",
				"sections": [
					{
						"name": "The Apotheosis",
						"ref": "Spaces Chapter III/Chapter III/The Apotheosis"
					},
					{
						"name": "A terrifying and divine heart",
						"ref": "Apotheosis Gallery 19/A terrifying and divine heart./A terrifying and divine heart"
					},
					{
						"name": "Oh, let me guess! and at the end of the path... is a cabin!",
						"ref": "Apotheosis Gallery 1/Oh, let me guess! and at the end of the path... is a cabin!/Gallery 1"
					},
					{
						"name": "This is how it always was going to end, and this is how it always was going to begin.",
						"ref": "Apotheosis Gallery 2/This is how it always was going to end, and this is how it always was going to begin./Gallery 2"
					},
					{
						"name": "Do it, then. Show me what you think it takes to end what's destined to end everything.",
						"ref": "Apotheosis Gallery 3/Do it, then. Show me what you think it takes to end what's destined to end everything./Gallery 3"
					},
					{
						"name": "Allow an ungrounded voice to tap into your potential.",
						"ref": "Apotheosis Gallery 4/Allow an ungrounded voice to tap into your potential./Gallery 4"
					},
					{
						"name": "Walk the razor's edge between courage and madness.",
						"ref": "Apotheosis Gallery 5/Walk the razor's edge between courage and madness./Gallery 5"
					},
					{
						"name": "Overpower a psychic barrier.",
						"ref": "Apotheosis Gallery 6/Overpower a psychic barrier./Gallery 6"
					},
					{
						"name": "Make her feel what you have felt.",
						"ref": "Apotheosis Gallery 7/Make her feel what you have felt./Gallery 7"
					},
					{
						"name": "Her touch is soft.",
						"ref": "Apotheosis Gallery 8/Her touch is soft./Gallery 8"
					},
					{
						"name": "Carve into her divine heart.",
						"ref": "Apotheosis Gallery 9/Carve into her divine heart./Gallery 9"
					},
					{
						"name": "Give a spiteful reminder to an arrogant god.",
						"ref": "Apotheosis Gallery 10/Give a spiteful reminder to an arrogant god./Gallery 10"
					},
					{
						"name": "Watch as the kindling of your soul burns to ash.",
						"ref": "Apotheosis Gallery 11/Watch as the kindling of your soul burns to ash./Gallery 11"
					},
					{
						"name": "We could have had everything.",
						"ref": "Apotheosis Gallery 12/We could have had everything./Gallery 12"
					},
					{
						"name": "If only you'd given me a little more.",
						"ref": "Apotheosis Gallery 13/If only you'd given me a little more./Gallery 13"
					},
					{
						"name": "What remnant of the old could possibly be left to defy me?",
						"ref": "Apotheosis Gallery 14/What remnant of the old could possibly be left to defy me?/Gallery 14"
					},
					{
						"name": "She is drowning.",
						"ref": "Apotheosis Gallery 15/She is drowning./Gallery 15"
					},
					{
						"name": "I am sorry.",
						"ref": "Apotheosis Gallery 16/I am sorry./Gallery 16"
					},
					{
						"name": "Fly, little bird.",
						"ref": "Apotheosis Gallery 17/Fly, little bird./Gallery 17"
					},
					{
						"name": "You've been here before.",
						"ref": "Apotheosis Gallery 18/You've been here before./Gallery 18"
					},
					{
						"name": "A terrifying and divine heart.",
						"ref": "Apotheosis Gallery 19/A terrifying and divine heart./Gallery 19"
					},
					{
						"name": "See through her eyes at the end of everything.",
						"ref": "Apotheosis Gallery 20/See through her eyes at the end of everything./Gallery 20"
					}
				],
				"map_locations": [
					{
						"map": "tower",
						"x": 1100,
						"y": 480
					},
					{
						"map": "overview",
						"x": 1438,
						"y": 450
					}
				]
			}
		]
