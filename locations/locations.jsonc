	{
		"name": "Adversary Combo",
		"children": [
			{
				"name": "The Adversary",
				"sections": [
					{
						"name": "The Adversary",
						"ref": "Spaces Chapter II/Chapter II/The Adversary"
					},
					{
						"name": "Mirror",
						"ref": "Adversary Gallery 1/I thought this was supposed to be a cabin./Mirror"
					},
					{
						"name": "A bold heart",
						"ref": "Adversary Gallery 19/A bold heart./A bold heart"
					},
					{
						"name": "I thought this was supposed to be a cabin.",
						"ref": "Adversary Gallery 1/I thought this was supposed to be a cabin./Gallery 1"
					},
					{
						"name": "If the Princess lives here, slaying her would probably be doing her a favor.",
						"ref": "Adversary Gallery 2/If the Princess lives here, slaying her would probably be doing her a favor./Gallery 2"
					},
					{
						"name": "Ignore the whiners. If she blocks your attack, you just have to push harder.",
						"ref": "Adversary Gallery 3/Ignore the whiners. If she blocks your attack, you just have to push harder./Gallery 3"
					},
					{
						"name": "Heeeeeere's Princess!",
						"ref": "Adversary Gallery 4/Heeeeeere's Princess!/Gallery 4"
					},
					{
						"name": "Die to her upstairs. Armed.",
						"ref": "Adversary Gallery 5/Die to her upstairs. Armed./Gallery 5"
					},
					{
						"name": "Die to her upstairs. Unarmed.",
						"ref": "Adversary Gallery 6/Die to her upstairs. Unarmed./Gallery 6"
					},
					{
						"name": "Witness her resurrection.",
						"ref": "Adversary Gallery 7/Witness her resurrection./Gallery 7"
					},
					{
						"name": "Goad her into giving you a free shot, and then take it.",
						"ref": "Adversary Gallery 8/Goad her into giving you a free shot, and then take it./Gallery 8"
					},
					{
						"name": "Make an obscene gesture, possibly against your will.",
						"ref": "Adversary Gallery 9/Make an obscene gesture, possibly against your will./Gallery 9"
					},
					{
						"name": "That which cannot die is that which cannot die is that which cannot die.",
						"ref": "Adversary Gallery 10/That which cannot die is that which cannot die is that which cannot die./Gallery 10"
					},
					{
						"name": "You don't need a weapon to win a fight.",
						"ref": "Adversary Gallery 11/You don't need a weapon to win a fight./Gallery 11"
					},
					{
						"name": "Maybe you do need a weapon, but it's too late now.",
						"ref": "Adversary Gallery 12/Maybe you do need a weapon, but it's too late now./Gallery 12"
					},
					{
						"name": "Hey, Princess... I didn't hear no bell.",
						"ref": "Adversary Gallery 13/Hey, Princess... I didn't hear no bell./Gallery 13"
					},
					{
						"name": "Sometimes you have to try and free people even if they don't realize they want to be free.",
						"ref": "Adversary Gallery 14/Sometimes you have to try and free people even if they don't realize they want to be free./Gallery 14"
					},
					{
						"name": "Agility is the only way to overcome brute strength.",
						"ref": "Adversary Gallery 15/Agility is the only way to overcome brute strength./Gallery 15"
					},
					{
						"name": "It's not a fight if you refuse to strike back.",
						"ref": "Adversary Gallery 16/It's not a fight if you refuse to strike back./Gallery 16"
					},
					{
						"name": "It's not a fight if you refuse to strike back.",
						"ref": "Adversary Gallery 17/It's not a fight if you refuse to strike back./Gallery 17"
					},
					{
						"name": "You've been here before.",
						"ref": "Adversary Gallery 18/You've been here before./Gallery 18"
					},
					{
						"name": "A bold heart.",
						"ref": "Adversary Gallery 19/A bold heart./Gallery 19"
					},
					{
						"name": "See through her eyes at the end of everything.",
						"ref": "Adversary Gallery 20/See through her eyes at the end of everything./Gallery 20"
					}
				],
				"map_locations": [
					{
						"map": "chapter 1",
						"x": 1600,
						"y": 860
					},
					{
						"map": "overview",
						"x": 1116,
						"y": 380
					}
				]
			}
		]
	},
