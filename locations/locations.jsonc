	{
		"name": "Fury Combo",
		"children": [
			{
				"name": "The Fury",
				"sections": [
					{
						"name": "The Fury",
						"ref": "Spaces Chapter III/Chapter III/The Fury"
					},
					{
						"name": "Mirror",
						"ref": "Fury Gallery 1/I thought this was supposed to be a cabin./Mirror"
					},
					{
						"name": "A weathered heart",
						"ref": "Fury Gallery 18/A weathered heart./A weathered heart"
					},
					{
						"name": "A weathered heart, held in ribbons",
						"ref": "Fury Gallery 19/A weathered heart, held in ribbons./A weathered heart, held in ribbons"
					},
					{
						"name": "A weathered heart, possibly held in ribbons",
						"ref": "Fury Gallery 18/A weathered heart./A weathered heart, possibly held in ribbons"
					},
					{
						"name": "I thought this was supposed to be a cabin.",
						"ref": "Fury Gallery 1/I thought this was supposed to be a cabin./Gallery 1"
					},
					{
						"name": "If the Princess lives here, slaying her would probably be doing her a favor.",
						"ref": "Fury Gallery 2/If the Princess lives here, slaying her would probably be doing her a favor./Gallery 2"
					},
					{
						"name": "You are deconstructed. You are reconstructed.",
						"ref": "Fury Gallery 3/You are deconstructed. You are reconstructed./Gallery 3"
					},
					{
						"name": "The ball is unraveled into the shape of a body.",
						"ref": "Fury Gallery 4/The ball is unraveled into the shape of a body./Gallery 4"
					},
					{
						"name": "The blade is still here, even after everything.",
						"ref": "Fury Gallery 5/The blade is still here, even after everything./Gallery 5"
					},
					{
						"name": "Give her your hand.",
						"ref": "Fury Gallery 6/Give her your hand./Gallery 6"
					},
					{
						"name": "I feel so cold. Is it because you're gone?",
						"ref": "Fury Gallery 7/I feel so cold. Is it because you're gone?/Gallery 7"
					},
					{
						"name": "If only you could remember what I remember. If only you weren't so weak.",
						"ref": "Fury Gallery 8/If only you could remember what I remember. If only you weren't so weak./Gallery 8"
					},
					{
						"name": "A towering heart wounded and alone. One that is familiar to you, if distant.",
						"ref": "Fury Gallery 9/A towering heart wounded and alone. One that is familiar to you, if distant./Gallery 9"
					},
					{
						"name": "What are you? You're clearly not your skin.",
						"ref": "Fury Gallery 10/What are you? You're clearly not your skin./Gallery 10"
					},
					{
						"name": "Come on. One more step. Do it! Hit me! Show me what you're made of!",
						"ref": "Fury Gallery 11/Come on. One more step. Do it! Hit me! Show me what you're made of!/Gallery 11"
					},
					{
						"name": "Preserved, perfectly, in the amber of her torment.",
						"ref": "Fury Gallery 12/Preserved, perfectly, in the amber of her torment./Gallery 12"
					},
					{
						"name": "It's not over. We're a god killer. We've returned from death itself twice.",
						"ref": "Fury Gallery 13/It's not over. We're a god killer. We've returned from death itself twice./Gallery 13"
					},
					{
						"name": "Now, little bird, what was it you wanted to tell me?",
						"ref": "Fury Gallery 14/Now, little bird, what was it you wanted to tell me?/Gallery 14"
					},
					{
						"name": "Let's see what meaning we can find together. Let's see what we're made of.",
						"ref": "Fury Gallery 15/Let's see what meaning we can find together. Let's see what we're made of./Gallery 15"
					},
					{
						"name": "We don't need to count anymore.",
						"ref": "Fury Gallery 16/We don't need to count anymore./Gallery 16"
					},
					{
						"name": "And then the forces disappear. The bonds holding your cells together break.",
						"ref": "Fury Gallery 17/And then the forces disappear. The bonds holding your cells together break./Gallery 17"
					},
					{
						"name": "A weathered heart.",
						"ref": "Fury Gallery 18/A weathered heart./Gallery 18"
					},
					{
						"name": "A weathered heart, held in ribbons.",
						"ref": "Fury Gallery 19/A weathered heart, held in ribbons./Gallery 19"
					},
					{
						"name": "See through her eyes at the end of everything.",
						"ref": "Fury Gallery 20/See through her eyes at the end of everything./Gallery 20"
					}
				],
				"map_locations": [
					{
						"map": "adversary",
						"x": 1600,
						"y": 290
					},
					{
						"map": "tower",
						"x": 1600,
						"y": 1050
					},
					{
						"map": "overview",
						"x": 1314,
						"y": 235
					}
				]
			}
		]
	},
