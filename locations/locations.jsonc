	{
		"name": "Den Combo",
		"children": [
			{
				"name": "The Den",
				"sections": [
					{
						"name": "The Den",
						"ref": "Spaces Chapter III/Chapter III/The Den"
					},
					{
						"name": "Mirror",
						"ref": "Den Gallery 2/Maybe this used to be a cabin./Mirror"
					},
					{
						"name": "A ravenous heart",
						"ref": "Den Gallery 19/A ravenous heart./A ravenous heart"
					},
					{
						"name": "The woods are... denser than I remember them.",
						"ref": "Den Gallery 1/The woods are... denser than I remember them./Gallery 1"
					},
					{
						"name": "Maybe this used to be a cabin.",
						"ref": "Den Gallery 2/Maybe this used to be a cabin./Gallery 2"
					},
					{
						"name": "To be torn between thought and action is to hesitate. And to hesitate is to die.",
						"ref": "Den Gallery 3/To be torn between thought and action is to hesitate. And to hesitate is to die./Gallery 3"
					},
					{
						"name": "Reject instinct. Fight her to the end.",
						"ref": "Den Gallery 4/Reject instinct. Fight her to the end./Gallery 4"
					},
					{
						"name": "Reject instinct. Fight her to the end.",
						"ref": "Den Gallery 5/Reject instinct. Fight her to the end./Gallery 5"
					},
					{
						"name": "Give yourself to instinct.",
						"ref": "Den Gallery 6/Give yourself to instinct./Gallery 6"
					},
					{
						"name": "To consume is to become.",
						"ref": "Den Gallery 7/To consume is to become./Gallery 7"
					},
					{
						"name": "Now that's she's stuck, there's nothing stopping you from ending this.",
						"ref": "Den Gallery 8/Now that's she's stuck, there's nothing stopping you from ending this./Gallery 8"
					},
					{
						"name": "I told you not to flinch, I told you.",
						"ref": "Den Gallery 9/I told you not to flinch, I told you./Gallery 9"
					},
					{
						"name": "Your work is done. Leave her to starve.",
						"ref": "Den Gallery 10/Your work is done. Leave her to starve./Gallery 10"
					},
					{
						"name": "Wait in silence for your end.",
						"ref": "Den Gallery 11/Wait in silence for your end./Gallery 11"
					},
					{
						"name": "Maybe there's more to her than we thought.",
						"ref": "Den Gallery 12/Maybe there's more to her than we thought./Gallery 12"
					},
					{
						"name": "Your mouths are full of dirt.",
						"ref": "Den Gallery 13/Your mouths are full of dirt./Gallery 13"
					},
					{
						"name": "She has left you to die.",
						"ref": "Den Gallery 14/She has left you to die./Gallery 14"
					},
					{
						"name": "Are we free?",
						"ref": "Den Gallery 15/Are we free?/Gallery 15"
					},
					{
						"name": "Reach the crossroads of will and instinct.",
						"ref": "Den Gallery 16/Reach the crossroads of will and instinct./Gallery 16"
					},
					{
						"name": "What once was you, now is me.",
						"ref": "Den Gallery 17/What once was you, now is me./Gallery 17"
					},
					{
						"name": "You've been here before.",
						"ref": "Den Gallery 18/You've been here before./Gallery 18"
					},
					{
						"name": "A ravenous heart.",
						"ref": "Den Gallery 19/A ravenous heart./Gallery 19"
					},
					{
						"name": "See through her eyes at the end of everything.",
						"ref": "Den Gallery 20/See through her eyes at the end of everything./Gallery 20"
					}
				],
				"map_locations": [
					{
						"map": "beast",
						"x": 1850,
						"y": 290
					},
					{
						"map": "overview",
						"x": 850,
						"y": 1038
					}
				]
			}
		]
	},
