  	{
		"name": "Razor Combo",
		"children": [
			{
				"name": "The Razor",
				"sections": [
					{
						"name": "The Razor",
						"ref": "Spaces Chapter II/Chapter II/The Razor"
					},
					{
						"name": "Mirror",
						"ref": "Razor Gallery 1/What a mess./Mirror"
					},
					{
						"name": "A piercing heart in a cage of iron",
						"ref": "Razor Gallery 17/A piercing heart in a cage of iron./A piercing heart in a cage of iron"
					},
					{
						"name": "A piercing heart beating free",
						"ref": "Razor Gallery 19/A piercing heart beating free./A piercing heart beating free"
					},
					{
						"name": "A piercing heart in a cage of iron or beating free",
						"ref": "Razor Gallery 17/A piercing heart in a cage of iron./A piercing heart in a cage of iron or beating free"
					},
					{
						"name": "What a mess.",
						"ref": "Razor Gallery 1/What a mess./Gallery 1"
					},
					{
						"name": "If the Princess lives here, slaying her would probably be doing her a favor.",
						"ref": "Razor Gallery 2/If the Princess lives here, slaying her would probably be doing her a favor./Gallery 2"
					},
					{
						"name": "But her hands were behind her back!",
						"ref": "Razor Gallery 3/But her hands were behind her back!/Gallery 3"
					},
					{
						"name": "Okay. I'm bored.",
						"ref": "Razor Gallery 4/Okay. I'm bored./Gallery 4"
					},
					{
						"name": "She said she wasn't armed. So what's the harm in getting a little closer?",
						"ref": "Razor Gallery 5/She said she wasn't armed. So what's the harm in getting a little closer?/Gallery 5"
					},
					{
						"name": "Now hold on... these aren't the woods.",
						"ref": "Razor Gallery 6/Now hold on... these aren't the woods./Gallery 6"
					},
					{
						"name": "What... is this place? This is not the same cabin.",
						"ref": "Razor Gallery 7/What... is this place? This is not the same cabin./Gallery 7"
					},
					{
						"name": "Meet her. Again.",
						"ref": "Razor Gallery 8/Meet her. Again./Gallery 8"
					},
					{
						"name": "Call an ambulance... but not for me!",
						"ref": "Razor Gallery 9/Call an ambulance... but not for me!/Gallery 9"
					},
					{
						"name": "Make her blush.",
						"ref": "Razor Gallery 10/Make her blush./Gallery 10"
					},
					{
						"name": "You've lost track of yourself, haven't you?",
						"ref": "Razor Gallery 11/You've lost track of yourself, haven't you?/Gallery 11"
					},
					{
						"name": "This isn't even my final form.",
						"ref": "Razor Gallery 12/This isn't even my final form./Gallery 12"
					},
					{
						"name": "Meet a mutual end.",
						"ref": "Razor Gallery 13/Meet a mutual end./Gallery 13"
					},
					{
						"name": "Empty your mind. Be formless. Shapeless. Like water.",
						"ref": "Razor Gallery 14/Empty your mind. Be formless. Shapeless. Like water./Gallery 14"
					},
					{
						"name": "Empty your mind. Be formless. Shapeless. Like water.",
						"ref": "Razor Gallery 15/Empty your mind. Be formless. Shapeless. Like water./Gallery 15"
					},
					{
						"name": "You've been here before, this time with a cage of iron.",
						"ref": "Razor Gallery 16/You've been here before, this time with a cage of iron./Gallery 16"
					},
					{
						"name": "A piercing heart in a cage of iron.",
						"ref": "Razor Gallery 17/A piercing heart in a cage of iron./Gallery 17"
					},
					{
						"name": "You've been here before, this time with a heart beating free.",
						"ref": "Razor Gallery 18/You've been here before, this time with a heart beating free./Gallery 18"
					},
					{
						"name": "A piercing heart beating free.",
						"ref": "Razor Gallery 19/A piercing heart beating free./Gallery 19"
					},
					{
						"name": "See through her eyes at the end of everything.",
						"ref": "Razor Gallery 20/See through her eyes at the end of everything./Gallery 20"
					}
				],
				"map_locations": [
					{
						"map": "chapter 1",
						"x": 1600,
						"y": 100
					},
					{
						"map": "overview",
						"x": 975,
						"y": 335
					}
				]
			}
		]
  	},
