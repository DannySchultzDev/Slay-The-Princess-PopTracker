	{
		"name": "Wraith Combo",
		"children": [
			{
				"name": "The Wraith",
				"sections": [
					{
						"name": "The Wraith",
						"ref": "Spaces Chapter III/Chapter III/The Wraith"
					},
					{
						"name": "Mirror",
						"ref": "Wraith Gallery 3/I thought this was supposed to be a cabin./Mirror"
					},
					{
						"name": "A driven heart",
						"ref": "Wraith Gallery 10/A driven heart./A driven heart"
					},
					{
						"name": "These aren't the same woods.",
						"ref": "Wraith Gallery 1/These aren't the same woods./Gallery 1"
					},
					{
						"name": "And this isn't the same cabin.",
						"ref": "Wraith Gallery 2/And this isn't the same cabin./Gallery 2"
					},
					{
						"name": "I thought this was supposed to be a cabin.",
						"ref": "Wraith Gallery 3/I thought this was supposed to be a cabin./Gallery 3"
					},
					{
						"name": "If the Princess lives here, slaying her would probably be doing her a favor.",
						"ref": "Wraith Gallery 4/If the Princess lives here, slaying her would probably be doing her a favor./Gallery 4"
					},
					{
						"name": "You are nothing but a passenger.",
						"ref": "Wraith Gallery 5/You are nothing but a passenger./Gallery 5"
					},
					{
						"name": "Set your demons loose upon the world.",
						"ref": "Wraith Gallery 6/Set your demons loose upon the world./Gallery 6"
					},
					{
						"name": "You're the only prison that can hold your demons.",
						"ref": "Wraith Gallery 7/You're the only prison that can hold your demons./Gallery 7"
					},
					{
						"name": "There is no choice here. She will take what she is owed.",
						"ref": "Wraith Gallery 8/There is no choice here. She will take what she is owed./Gallery 8"
					},
					{
						"name": "You've been here before.",
						"ref": "Wraith Gallery 9/You've been here before./Gallery 9"
					},
					{
						"name": "A driven heart.",
						"ref": "Wraith Gallery 10/A driven heart./Gallery 10"
					},
					{
						"name": "See through her eyes at the end of everything.",
						"ref": "Wraith Gallery 11/See through her eyes at the end of everything./Gallery 11"
					}
				],
				"map_locations": [
